{
  "expo": {
    "name": "COUSP Task",
    "slug": "cousp-task",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cd.cousp.task"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F4C81",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "cd.cousp.task"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#0F4C81"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "COUSP Task utilise l'appareil photo pour joindre des preuves d'exécution aux tâches.",
          "photosPermission": "COUSP Task accède à vos photos pour les joindre aux tâches."
        }
      ]
    ],
    "scheme": "cousptask",
    "extra": {
      "apiUrl": "http://10.0.2.2:8000/api/v1"
    }
  }
}
