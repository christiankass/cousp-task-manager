# ============================================================================
#  COUSP Task Manager : réglages de production
#  Copier vers .env.production (à la racine du dépôt), compléter, ne JAMAIS publier ce fichier.
#  Générer un mot de passe solide :  openssl rand -base64 32
# ============================================================================

# --- Adresse publique -------------------------------------------------------
APP_DOMAIN=taches.cousp.cd
APP_URL=https://taches.cousp.cd
WEB_URL=https://taches.cousp.cd
APP_NAME="COUSP Task Manager"
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
# Version des images Docker (par ex. la date de mise à jour)
APP_VERSION=2026.11

# Clé de chiffrement de l'application. Générer UNE fois puis conserver précieusement :
#   docker compose -f docker-compose.prod.yml run --rm --no-deps --entrypoint php api artisan key:generate --show
# Sans cette clé, les secrets de double authentification ne peuvent plus être lus.
APP_KEY=

# --- Base de données --------------------------------------------------------
POSTGRES_DB=cousp_task
# Compte d'administration PostgreSQL (maintenance, sauvegardes)
POSTGRES_ADMIN_USER=cousp_admin
POSTGRES_ADMIN_PASSWORD=
# Compte utilisé par l'application : jamais super-utilisateur (isolation des institutions)
APP_DB_USER=cousp_app
APP_DB_PASSWORD=

# --- Cache et file d'attente ------------------------------------------------
REDIS_PASSWORD=

# --- Sécurité ---------------------------------------------------------------
# Durée de validité d'une connexion, en minutes (8 h)
SANCTUM_TOKEN_EXPIRATION=480
# true = les comptes à privilèges (administration, rôles, paramètres, circuits de validation)
# doivent activer la connexion en deux étapes avant de pouvoir travailler.
MFA_ENFORCE_PRIVILEGED=true
MFA_ISSUER="COUSP Task"
BCRYPT_ROUNDS=12
LOG_LEVEL=warning

# --- E-mails ----------------------------------------------------------------
MAIL_NOTIFICATIONS=true
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.org
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@cousp.cd
MAIL_FROM_NAME="COUSP Task Manager"

# --- Notifications push (application mobile) -------------------------------
PUSH_NOTIFICATIONS=true
# Jeton d'accès Expo (facultatif, recommandé) : https://expo.dev/accounts/[compte]/settings/access-tokens
EXPO_ACCESS_TOKEN=

# --- Fichiers joints --------------------------------------------------------
ATTACHMENTS_DISK=local
ATTACHMENTS_MAX_KB=20480

# --- Sauvegardes (script infrastructure/production/scripts/backup.sh) -------
# Dossier des sauvegardes sur le serveur, et nombre de jours de conservation
BACKUP_DIR=/srv/cousp-backups
BACKUP_RETENTION_DAYS=30
# Fichier contenant la phrase secrète de chiffrement des sauvegardes (chmod 600).
# Gardez une copie de cette phrase HORS du serveur : sans elle, les sauvegardes sont illisibles.
BACKUP_PASSPHRASE_FILE=/root/.cousp-backup-passphrase
